const { PutObjectCommand } = require("@aws-sdk/client-s3");
const s3 = require("../config/s3");

/**
 * Upload a file buffer to S3.
 * Throws an error if AWS credentials are not configured or upload fails.
 * @param {Object} file - Multer file object
 * @param {string} folder - Target folder path
 * @param {Object} [actorOrReq] - Optional actor or req for tracking
 * @param {Object} [options] - Optional metadata
 * @returns {Promise<string>} - Public S3 URL
 */
const uploadToS3 = async (file, folder = "uploads", actorOrReq = null, options = {}) => {
  // Check if AWS credentials are configured
  const hasAWSConfig = process.env.AWS_ACCESS_KEY_ID && process.env.AWS_SECRET_ACCESS_KEY && process.env.AWS_REGION && process.env.AWS_BUCKET_NAME;

  if (!hasAWSConfig) {
    console.log(`[Upload] AWS credentials not fully configured. Falling back to local storage for folder: ${folder}`);
    const uploadLocal = require("./uploadLocal.js");
    return uploadLocal(file, folder, actorOrReq, options);
  }

  try {
    const timestamp = Date.now();
    const sanitizedFileName = file.originalname.replace(/[^a-zA-Z0-9.\-_]/g, "_");
    const key = `${folder}/${timestamp}_${sanitizedFileName}`;

    const command = new PutObjectCommand({
      Bucket: process.env.AWS_BUCKET_NAME,
      Key: key,
      Body: file.buffer,
      ContentType: file.mimetype,
    });

    await s3.send(command);
    
    // Construct URL based on region
    const region = process.env.AWS_REGION;
    const bucket = process.env.AWS_BUCKET_NAME;
    const s3Url = `https://${bucket}.s3.${region}.amazonaws.com/${key}`;
    
    // Automatic upload tracking
    if (actorOrReq) {
      try {
        const { trackUpload } = require("../modules/StaffPerformance/Service/staffActivityService");
        const actor = actorOrReq.user || actorOrReq;
        let moduleName = options.module;
        if (!moduleName) {
          const upperFolder = folder.toUpperCase();
          if (upperFolder.includes("INVOICE")) moduleName = "INVOICE";
          else if (upperFolder.includes("BILL")) moduleName = "BILL";
          else if (upperFolder.includes("DEBIT")) moduleName = "DEBIT_NOTE";
          else if (upperFolder.includes("CREDIT")) moduleName = "CREDIT_NOTE";
          else if (upperFolder.includes("BANK") || upperFolder.includes("STATEMENT")) moduleName = "BANK_STATEMENT";
          else if (upperFolder.includes("PAYMENT")) moduleName = "BANK_PAYMENT_PROOF";
          else moduleName = "GENERAL";
        }

        trackUpload({
          file,
          fileUrl: s3Url,
          storageType: "S3",
          module: moduleName,
          entityId: options.entityId,
          entityReference: options.entityReference,
          actor,
          notes: options.notes,
          metadata: { ...options.metadata, s3Key: key }
        }).catch(err => console.error("[uploadToS3] Async track error:", err.message));
      } catch (trackErr) {
        // Non-blocking
      }
    }

    return s3Url;
  } catch (error) {
    console.error("[Upload] S3 upload failed:", error.message);
    throw error;
  }
};

module.exports = uploadToS3;
